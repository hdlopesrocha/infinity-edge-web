{
  "name": "infinity-edge-web",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "description": "IE3D_37_T (XNA) migrated to the browser: Vue 3 + TypeScript + raw WebGL2 + gl-matrix",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "dev:https": "node tools/dev-cert.mjs && vite --port 5173 --strictPort",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "convert:models": "node tools/convert-xnb.mjs",
    "convert:levels": "node tools/convert-levels.mjs",
    "convert": "npm run convert:models && npm run convert:levels",
    "copy:assets": "node tools/copy-assets.mjs",
    "assets:manifest": "node tools/asset-manifest.mjs",
    "asset-server": "node tools/asset-server.mjs --port 8090",
    "server:build": "cmake -S server -B build/server && cmake --build build/server -j",
    "server:run": "build/server/ie-server --port 8091 --root dist",
    "server:test": "ctest --test-dir build/server --output-on-failure",
    "mp:relay": "node tools/relay.mjs --port 7777",
    "mp:e2e": "node tools/mp-e2e.mjs",
    "room:e2e": "node tools/room-e2e.mjs",
    "ui:e2e": "node tools/ui-e2e.mjs",
    "mp:server": "build/server/ie-server --port 8097 --root dist --room ctf-easy",
    "mp:server-e2e": "node tools/server-mp-e2e.mjs",
    "shots": "node tools/screenshots.mjs",
    "deploy": "node tools/deploy-gh-pages.mjs",
    "probe": "node tools/probe.mjs"
  },
  "dependencies": {
    "gl-matrix": "^3.4.3",
    "pako": "^2.1.0",
    "vue": "^3.5.43",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/pako": "^2.0.4",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/ui": "^5.0.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^5.0.4",
    "vue-tsc": "^2.1.10",
    "ws": "^8.22.0"
  }
}
