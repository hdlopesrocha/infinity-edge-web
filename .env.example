# Infinity Edge — example configuration. Copy to .env and fill in.
# .env is gitignored. The client reads VITE_* (Vite exposes them at build time);
# the game has no server-side currency any more.

# --------------------------------------------------------------- client
# Relay set used for multiplayer rooms, DMs and the high-score profiles
# (falls back to the built-in defaults when unset).
VITE_IE_MP_RELAYS=wss://nos.lol,wss://relay.snort.social
# Lightning address (LUD-16) that receives shop payments. Leave empty to make
# the shop read-only (items show their price but cannot be bought).
VITE_IE_SHOP_LUD16=
